# Public site origin used for canonical URLs, sitemap, and Open Graph.
# GitHub Pages project site:
PUBLIC_SITE_URL=https://hstev.github.io

# Astro base path. Must start and end with a slash, except for root `/`.
# GitHub Pages project site:
PUBLIC_BASE_PATH=/lyric-guess/

# For local development at http://localhost:4321/ instead of /lyric-guess/:
# PUBLIC_BASE_PATH=/

# Default countdown for a round, in seconds.
PUBLIC_DEFAULT_TIMER_SECONDS=15
