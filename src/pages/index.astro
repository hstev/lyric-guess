---
import { defaultLocale, locales, LOCALE_STORAGE_KEY, localePath, type Locale } from '../i18n';
import { absoluteUrl, withBase } from '../utils/paths';

const fallbackPath = localePath(defaultLocale, '/');
const fallbackHref = withBase(fallbackPath);
const localeHrefs: Record<Locale, string> = {
  es: absoluteUrl(localePath('es', '/'), Astro.site),
  en: absoluteUrl(localePath('en', '/'), Astro.site),
};
---

<!doctype html>
<html lang={defaultLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <meta http-equiv="refresh" content={`0;url=${fallbackHref}`} />
    <link rel="canonical" href={localeHrefs[defaultLocale]} />
    {locales.map((code) => <link rel="alternate" hreflang={code} href={localeHrefs[code]} />)}
    <link rel="alternate" hreflang="x-default" href={localeHrefs[defaultLocale]} />
    <title>Lyric-Guess</title>
    <script
      is:inline
      define:vars={{
        defaultLocale,
        locales,
        storageKey: LOCALE_STORAGE_KEY,
        base: import.meta.env.BASE_URL,
      }}
    >
      (function () {
        var lang = defaultLocale;
        try {
          var stored = localStorage.getItem(storageKey);
          if (stored && locales.indexOf(stored) !== -1) {
            lang = stored;
          } else {
            var nav = (navigator.language || '').slice(0, 2).toLowerCase();
            lang = nav === 'es' ? 'es' : 'en';
          }
        } catch (error) {
          lang = defaultLocale;
        }
        var prefix = String(base).replace(/\/$/, '');
        location.replace(prefix + '/' + lang);
      })();
    </script>
  </head>
  <body>
    <p><a href={fallbackHref}>Lyric-Guess</a></p>
  </body>
</html>
