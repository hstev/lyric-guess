{
  "name": "lyric-guess",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Guess the song from a lyric fragment.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
