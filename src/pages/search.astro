---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
  title="Search · Lyric-Guess"
  description="Find a song by title, artist, or category. Search runs in SQLite inside the browser."
  canonicalPath="/search"
  current="search"
>
  <section class="page-hero">
    <p class="kicker">Find a fragment</p>
    <h1 class="display">Search the room.</h1>
  </section>
  <div id="search-root"></div>
</SiteLayout>

<script>
  import { mountSearch } from '../features/search/mount-search';

  const root = document.getElementById('search-root');
  if (root) {
    void mountSearch(root);
  }
</script>
