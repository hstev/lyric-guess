---
import type { Category } from '../types/catalog';
import type { Locale } from '../i18n';
import { useTranslations } from '../i18n';
import { withLocale } from '../utils/paths';

type Props = {
  locale: Locale;
  categories: Category[];
  currentSlug?: string | undefined;
  includeAll?: boolean;
};

const { locale, categories, currentSlug, includeAll = true } = Astro.props;
const t = useTranslations(locale);
---

<div class="pills" role="navigation" aria-label={t('nav.categories')}>
  {
    includeAll && (
      <a
        class:list={['pill', { 'is-active': !currentSlug }]}
        href={withLocale(locale, '/categories')}
        aria-current={!currentSlug ? 'page' : undefined}
      >
        {t('categories.all')}
      </a>
    )
  }
  {
    categories.map((category) => (
      <a
        class:list={['pill', { 'is-active': currentSlug === category.slug }]}
        href={withLocale(locale, `/categories/${category.slug}`)}
        aria-current={currentSlug === category.slug ? 'page' : undefined}
      >
        {category.name}
      </a>
    ))
  }
</div>
