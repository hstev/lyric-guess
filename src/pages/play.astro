---
import GameLayout from '../layouts/GameLayout.astro';
---

<GameLayout
  title="Play · Lyric-Guess"
  description="A full-screen lyric round with a countdown, a reveal, and a playable fragment."
>
  <div id="game-root" class="game"></div>
</GameLayout>

<script>
  import { mountGame } from '../features/game/mount-game';

  const root = document.getElementById('game-root');
  if (root) {
    void mountGame(root);
  }
</script>
